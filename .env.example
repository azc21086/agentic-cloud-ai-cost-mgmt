# The package reads these from the shell environment. It does NOT load .env files on its own.
# To use a file: copy to .env (already git-ignored), fill in, then run:  set -a; source .env; set +a
GCSI_API_KEY=
# Optional: any OpenAI-compatible endpoint (Azure gateway, vLLM, Ollama, OpenRouter, ...)
GCSI_BASE_URL=
GCSI_MODEL=gpt-4o-mini
